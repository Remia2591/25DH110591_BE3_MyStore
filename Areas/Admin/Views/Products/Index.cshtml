@model IEnumerable<_25DH110591_MyStore.Models.Product>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">DANH SÁCH SẢN PHẨM</h2>

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered">
    <tr class="bg-success">
        <th>Hình ảnh</th>
        <th>Tên sản phẩm</th>
        <th>Đơn giá</th>
        <th>Danh mục</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(item.ProductImage))
                {
                    <img src="@Url.Content("~/Content/Images/" + item.ProductImage)"
                         width="80" />
                }
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.ProductPrice)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Category.CategoryName)
            </td>

            <td>
                @Html.ActionLink("Sửa", "Edit",
                    new { id = item.ProductID },
                    new { @class = "btn btn-warning" })

                @Html.ActionLink("Chi tiết", "Details",
                    new { id = item.ProductID },
                    new { @class = "btn btn-info" })

                @Html.ActionLink("Xóa", "Delete",
                    new { id = item.ProductID },
                    new { @class = "btn btn-danger" })
            </td>
        </tr>
    }
</table>
